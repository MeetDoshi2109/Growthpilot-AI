# ─── GrowthPilot AI — Environment Variables ───────────────────────────────────
# Copy to .env and fill in values.
# For local dev: copy to backend/.env
# For Vercel: set NEXT_PUBLIC_* in Vercel Dashboard
# For Railway/Render: set backend vars in service environment

# ── Backend ────────────────────────────────────────────────────────────────────

# Database — SQLite (no Docker required for local dev)
DATABASE_URL=sqlite+aiosqlite:///./growthpilot.db
SYNC_DATABASE_URL=sqlite:///./growthpilot.db

# Security
JWT_SECRET_KEY=change-me-in-production-use-32-chars-minimum

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Sandbox
SANDBOX_MODE=true

# Data seeding
SEED=42
NUM_CUSTOMERS=5000
NUM_TRANSACTIONS=20000

# LLM Provider: mock | none | gemini | openai
# Use "none" or "mock" for demo (no API key needed)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS — add your Vercel frontend URL
CORS_ORIGINS=http://localhost:3000

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────

# Backend URL
# Local dev: http://localhost:8000
# Production (Vercel): https://your-railway-app.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SANDBOX=true
